# Copy to .env.local after inspecting existing configuration.
# Keep .env.local and other real secrets out of Git.
# Quote mode works with execution disabled. The execution variables below are
# server-only unless their names explicitly begin with NEXT_PUBLIC_.

# Optional for walletless comparison; required by the managed execute flow.
JUPITER_API_KEY=

# Server-side RPC. Replace with a reliable private endpoint when available.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Only a public, nonsecret endpoint may appear in a NEXT_PUBLIC variable.
# Wallet Adapter can use this while private RPC calls stay on the server.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

APP_ORIGIN=http://localhost:3000

# Exact lowercase "true" is required. Enabling is not proof of eligibility.
EXECUTION_ENABLED=false

# Comma-separated base58 tester wallets. When nonempty, every execution endpoint
# enforces this list after verifying wallet ownership with signMessage.
EXECUTION_ALLOWED_WALLETS=

# Server-only HMAC secret, minimum 32 characters. Generate a random value, e.g.:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
# Do not reuse a wallet secret, seed phrase, API key, or client-visible value.
EXECUTION_INTENT_SECRET=
